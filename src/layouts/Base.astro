---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { site, analytics } from '../data/site';
import { personJsonLd } from '../data/outputs';

interface Props {
  title?: string;
  description?: string;
  /** Path for the canonical URL, e.g. "/". */
  path?: string;
  noindex?: boolean;
  footerRule?: boolean;
  /** Include the Person structured data (home page only). */
  structuredData?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  noindex = false,
  footerRule = false,
  structuredData = false,
} = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og-image.png', site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/markdown" href="/resume.md" title="CV in Markdown" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd())} />}
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Apply a saved theme before first paint, so there is no flash of the wrong theme. -->
    <script is:inline>
      (function () {
        var r = document.documentElement;
        r.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') r.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer rule={footerRule} />
    <CommandPalette />
    <!-- Cloudflare Web Analytics: cookieless, loaded without blocking the page. -->
    <script is:inline defer src={analytics.script} data-cf-beacon={JSON.stringify({ token: analytics.token })}></script>
  </body>
</html>
