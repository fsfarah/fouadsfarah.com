---
import { email, hero, links } from '../data/site';
---

<dialog class="palette" aria-labelledby="palette-title" data-palette>
  <div class="top">
    <span id="palette-title" class="mono label">Commands</span>
    <button type="button" class="esc" data-palette-close aria-label="Close command palette">
      <kbd>esc</kbd>
    </button>
  </div>
  <ul class="rows" data-palette-rows>
    <li>
      <button type="button" class="row" data-action="theme" autofocus>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
        </svg>
        <span class="name" data-theme-label>Switch theme</span>
        <span class="hint mono">Theme</span>
      </button>
    </li>
    <li>
      <a class="row" href={hero.cv.href} data-action="close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path>
        </svg>
        <span class="name">Download CV</span>
        <span class="hint mono">PDF</span>
      </a>
    </li>
    <li>
      <button type="button" class="row" data-action="copy" data-user={email.user} data-domain={email.domain} data-tld={email.tld}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11"></rect><path d="M5 15V4h11"></path>
        </svg>
        <span class="name">Copy email address</span>
        <span class="hint mono" data-copy-ready data-email-slot></span>
        <span class="hint mono done" data-copy-done hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          Copied
        </span>
      </button>
    </li>
    <li>
      <a class="row" href={links.linkedin.href} target="_blank" rel="noopener" data-action="close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7"></path><path d="M8 7h9v9"></path>
        </svg>
        <span class="name">Open {links.linkedin.label}<span class="visually-hidden"> (opens in a new tab)</span></span>
        <span class="hint mono" aria-hidden="true">linkedin.com ↗</span>
      </a>
    </li>
  </ul>
  <div class="keys mono" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>enter</kbd> run</span>
  </div>
  <span class="visually-hidden" role="status" aria-live="polite" data-palette-status></span>
</dialog>

<style>
  .palette {
    width: 35rem;
    max-width: calc(100vw - 2rem);
    margin: 9.25rem auto auto;
    padding: 0;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 0;
    box-shadow:
      0 24px 64px rgba(15, 21, 20, 0.22),
      0 2px 8px rgba(15, 21, 20, 0.08);
  }
  .palette::backdrop {
    background: var(--backdrop);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 3.25rem;
    padding: 0 0.375rem 0 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .label {
    font-size: 0.75rem;
    color: var(--muted);
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    padding: 0 0.375rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--rule);
  }
  .esc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 3.25rem;
    padding: 0 0.875rem;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    text-align: left;
    text-decoration: none;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .row svg {
    flex: none;
    color: var(--muted);
  }
  .row:hover,
  .row:focus {
    background: var(--row-selected);
  }
  /* The selected row: tinted background plus the accent outline. */
  .row:focus {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .row:focus svg {
    color: var(--accent);
  }
  .name {
    flex: 1 1 auto;
  }
  .hint {
    font-size: 0.75rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .done {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--accent);
  }
  .done[hidden] {
    display: none;
  }
  .keys {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .keys span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  /* Motion: a soft fade and a 98% → 100% scale; open 0.15 s, close 0.12 s.
     close() runs immediately, so Escape and focus return are never delayed. */
  @media (prefers-reduced-motion: no-preference) {
    .palette,
    .palette::backdrop {
      transition:
        opacity 0.12s ease-in,
        transform 0.12s ease-in,
        overlay 0.12s ease-in allow-discrete,
        display 0.12s ease-in allow-discrete;
      opacity: 0;
    }
    .palette {
      transform: scale(0.98);
    }
    .palette[open],
    .palette[open]::backdrop {
      opacity: 1;
      transition-duration: 0.15s;
      transition-timing-function: ease-out;
    }
    .palette[open] {
      transform: none;
    }
    @starting-style {
      .palette[open],
      .palette[open]::backdrop {
        opacity: 0;
      }
      .palette[open] {
        transform: scale(0.98);
      }
    }
    .row {
      transition: background-color 0.12s ease;
    }
  }
</style>

<script>
  import { toggleTheme, toggleLabel, onThemeChange } from '../scripts/theme';
  import { assemble, copyText } from '../scripts/email';

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');

  if (dialog && typeof dialog.showModal === 'function') {
    const rows = () => Array.from(dialog.querySelectorAll<HTMLElement>('.row'));
    const status = dialog.querySelector<HTMLElement>('[data-palette-status]');
    const announce = (text: string) => {
      if (status) status.textContent = text;
    };

    let opener: HTMLElement | null = null;
    const open = () => {
      if (dialog.open) return;
      const active = document.activeElement;
      opener = active instanceof HTMLElement && active !== document.body ? active : null;
      announce('');
      dialog.showModal(); // focus moves to the autofocus row; the page behind is inert
    };
    const close = () => {
      if (!dialog.open) return;
      dialog.close();
      // Return focus at once (the exit fade is purely visual). If nothing had focus
      // before, make sure it doesn't stay on a row inside the closed dialog.
      if (opener?.isConnected) opener.focus();
      else if (dialog.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
      opener = null;
    };
    // Escape: the browser closes the dialog; route it through close() for the same focus handling.
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    // Openers: the header button and the keyboard shortcut.
    document.querySelectorAll('[data-palette-open]').forEach((el) => el.addEventListener('click', open));
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        dialog.open ? close() : open();
      }
    });

    // Close: the esc button, and a click on the backdrop (the dialog element itself has no padding).
    dialog.querySelector('[data-palette-close]')?.addEventListener('click', close);
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    // Arrow keys move between actions (wrapping); Home/End jump.
    dialog.addEventListener('keydown', (e) => {
      const list = rows();
      const i = list.indexOf(document.activeElement as HTMLElement);
      let next = -1;
      if (e.key === 'ArrowDown') next = i < 0 ? 0 : (i + 1) % list.length;
      else if (e.key === 'ArrowUp') next = i < 0 ? list.length - 1 : (i - 1 + list.length) % list.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = list.length - 1;
      if (next >= 0) {
        e.preventDefault();
        list[next].focus();
      }
    });

    // Theme, Download CV and Open LinkedIn close the palette once they've run;
    // Copy keeps it open so the confirmation stays visible.
    // Theme: switch, then close.
    const themeRow = dialog.querySelector<HTMLButtonElement>('[data-action="theme"]');
    const themeLabel = dialog.querySelector<HTMLElement>('[data-theme-label]');
    onThemeChange(() => {
      if (themeLabel) themeLabel.textContent = toggleLabel();
    });
    themeRow?.addEventListener('click', () => {
      toggleTheme();
      close();
    });

    // Copy email: stays open, shows "✓ Copied" for 2 seconds and announces it.
    const copyRow = dialog.querySelector<HTMLButtonElement>('[data-action="copy"]');
    const ready = dialog.querySelector<HTMLElement>('[data-copy-ready]');
    const done = dialog.querySelector<HTMLElement>('[data-copy-done]');
    const address = copyRow ? assemble(copyRow) : null;
    if (ready && address) ready.textContent = address;
    let copiedTimer: number | undefined;
    const resetCopy = () => {
      window.clearTimeout(copiedTimer);
      if (ready) ready.hidden = false;
      if (done) done.hidden = true;
    };
    dialog.addEventListener('close', resetCopy);
    copyRow?.addEventListener('click', async () => {
      if (!address) return;
      const ok = await copyText(address);
      if (!ok) {
        announce(`Copying failed. The address is ${address}`);
        return;
      }
      if (ready) ready.hidden = true;
      if (done) done.hidden = false;
      announce('Email address copied');
      window.clearTimeout(copiedTimer);
      copiedTimer = window.setTimeout(resetCopy, 2000);
    });

    // Download CV and Open LinkedIn are real links; they run and close the palette.
    dialog.querySelectorAll('[data-action="close"]').forEach((el) => el.addEventListener('click', () => close()));
  }
</script>
