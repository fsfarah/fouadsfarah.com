---
import { site, hero } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="dot-field" aria-hidden="true"><div class="dot-sweep"></div></div>
  <div class="wrap grid content">
    <div class="rail section-number" aria-hidden="true">00</div>
    <div class="main">
      <h1 id="hero-title" class="statement">
        {hero.statement.plain}<span class="accent">{hero.statement.accent}</span>
      </h1>
      <div class="lines">
        <p class="headline">
          <span class="desktop-headline">{site.headline}</span>
          <span class="phone-headline">
            {site.headlineLines[0]}<br />{site.headlineLines[1]}
          </span>
        </p>
        <p class="meta">
          <span>
            {site.focus.map((f, i) => (<>{i > 0 && <span aria-hidden="true"> · </span>}{f}</>))}
          </span>
          <span>{site.location}</span>
        </p>
      </div>
      <p class="intro">{hero.intro}</p>
      <a class="cv" href={hero.cv.href}>
        {hero.cv.label} <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 6rem;
  }
  .content {
    position: relative;
  }
  .rail {
    padding-top: 1rem;
  }
  .statement {
    margin: 0;
    max-width: 12.48em; /* 20ch in Schibsted Grotesk 600, fixed so the fallback font wraps the same */
    font-size: clamp(2.25rem, min(4.4vw, 8vh), 4rem);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .accent {
    color: var(--accent);
  }
  .lines {
    margin-top: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .headline {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .phone-headline {
    display: none;
  }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .intro {
    margin: 1.75rem 0 0;
    max-width: 37.9em; /* 62ch in Schibsted Grotesk 400 */
    font-size: 1.1875rem;
    line-height: 1.65;
  }
  .cv {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .cv:hover {
    text-decoration-thickness: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .cv {
      transition: text-decoration-thickness 0.2s ease;
    }
  }

  @media (max-width: 51.25rem) {
    .hero {
      padding-top: 3rem;
      padding-bottom: 3.5rem;
    }
    .statement {
      font-size: 2.25rem;
    }
    .lines {
      margin-top: 1.5rem;
    }
    .headline {
      font-size: 1.25rem;
    }
    .desktop-headline {
      display: none;
    }
    .phone-headline {
      display: inline;
    }
    .meta {
      flex-direction: column;
      gap: 0.125rem;
      font-size: 0.9375rem;
    }
    .intro {
      font-size: 1.0625rem;
    }
  }
</style>

<script>
  // Replays the dot-grid sweep when the visitor returns to the very top of the page
  // after the hero has been fully scrolled out, so the whole sweep is in view.
  // The sweep itself is CSS; this only restarts it. Nothing happens with reduced
  // motion (the CSS defines no animation then).
  const hero = document.querySelector<HTMLElement>('.hero');
  const sweep = hero?.querySelector<HTMLElement>('.dot-sweep');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && sweep && 'IntersectionObserver' in window) {
    let armed = false;
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) armed = true;
    }).observe(hero);

    window.addEventListener(
      'scroll',
      () => {
        if (!armed || window.scrollY > 0) return;
        armed = false;
        if (reduce.matches) return;
        sweep.classList.add('replay');
        sweep.style.animation = 'none';
        void sweep.offsetWidth; // flush styles so the animation starts again
        sweep.style.animation = '';
      },
      { passive: true },
    );
  }
</script>
