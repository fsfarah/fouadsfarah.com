---
import { site } from '../data/site';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="name" href="/">{site.name}</a>
    <nav aria-label="Primary" class="nav mono">
      <span class="links">
        <a href="/#work">Work</a>
        <a href="/#experience">Experience</a>
        <a href="/#contact">Contact</a>
      </span>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch to dark theme">
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
        </svg>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 4.75rem;
    gap: 1.5rem;
  }
  .name {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    font-size: 0.8125rem;
  }
  .links {
    display: flex;
    gap: 0.25rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    color: var(--muted);
    text-decoration: none;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .links a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .icon-btn {
    display: none; /* needs JavaScript; shown once the page adds .js */
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--rule);
    cursor: pointer;
  }
  :global(.js) .icon-btn {
    display: inline-flex;
  }
  .icon-btn:hover {
    color: var(--text);
  }
  .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }
  }
  @media (max-width: 51.25rem) {
    .links {
      display: none;
    }
  }
</style>

<script>
  // Theme switch: follows the system until the visitor chooses, then remembers the choice.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const isDark = () => {
    const set = root.getAttribute('data-theme');
    return set ? set === 'dark' : media.matches;
  };
  const sync = () => {
    button?.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
  };

  button?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });
  media.addEventListener('change', sync);
  sync();
</script>
