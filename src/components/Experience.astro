---
import { roles, education, languages, yearsLabel } from '../data/site';
---

<section id="experience" class="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="grid heading">
      <span class="rail section-number" aria-hidden="true">02</span>
      <h2 id="experience-title" class="main section-title">Experience</h2>
    </div>
    <div class="grid body">
      <div class="main">
        <ol class="jobs">
          {roles.map((role) => (
            <li class="job">
              <span class="years mono">{yearsLabel(role)}</span>
              <span class="what">
                <span class="employer">{role.employer}</span>
                <span class="title"> · {role.title}{role.location ? ` · ${role.location}` : ''}</span>
                <span class="stack mono">{role.siteStack.join(', ')}</span>
              </span>
            </li>
          ))}
        </ol>
        <ul class="more">
          {education.map((e) => (
            <li>{e.degree} {e.field}, {e.school}, {e.place}</li>
          ))}
          <li>{languages.map((l) => `${l.name} (${l.level})`).join(' · ')}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .experience {
    padding-top: 5.5rem;
    padding-bottom: 7.5rem;
    scroll-margin-top: 1.5rem;
  }
  .heading {
    align-items: baseline;
  }
  .body {
    margin-top: 3rem;
  }
  .jobs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }
  .job {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    column-gap: 2rem;
    border-top: 1px solid var(--rule);
    padding-block: 1.125rem;
  }
  .years {
    padding-top: 0.1875rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .what {
    font-size: 1.0625rem;
  }
  .employer {
    font-weight: 500;
  }
  .title {
    color: var(--muted);
  }
  .stack {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .more {
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 51.25rem) {
    .experience {
      padding-top: 3.5rem;
      padding-bottom: 4.5rem;
    }
    .body {
      margin-top: 2rem;
    }
    .job {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.25rem;
    }
    .more {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
