---
import { contact, email, links } from '../data/site';
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="grid heading">
      <span class="rail section-number" aria-hidden="true">03</span>
      <h2 id="contact-title" class="main section-title">Contact</h2>
    </div>
    <div class="grid body">
      <div class="main stack">
        <p class="invite">
          {contact.lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
        </p>
        <div class="actions">
          <a class="linkedin" href={links.linkedin.href} target="_blank" rel="noopener">
            {links.linkedin.label} <span class="arrow" aria-hidden="true">↗</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          <span class="email-row" data-email data-user={email.user} data-domain={email.domain} data-tld={email.tld}>
            <!-- Without JavaScript this stays in its scraper-resistant form; a script assembles the address. -->
            <span class="email-text" data-email-text>{email.user} [at] {email.domain}.{email.tld}</span>
            <button type="button" class="copy mono" data-copy hidden aria-label="Copy email address">
              <span data-copy-ready>Copy</span>
              <span class="done" data-copy-done hidden>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                Copied
              </span>
            </button>
            <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--banner-bg);
    color: var(--banner-text);
    padding-top: 5.5rem;
    padding-bottom: 6.5rem;
    scroll-margin-top: 1.5rem;
  }
  .contact :global(.section-number) {
    color: var(--banner-accent);
  }
  .contact :focus-visible {
    outline-color: var(--banner-text);
  }
  .heading {
    align-items: baseline;
  }
  .body {
    margin-top: 1.75rem;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .invite {
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--banner-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 3rem;
  }
  .linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--banner-text);
    text-decoration: underline;
    text-decoration-color: var(--banner-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .linkedin:hover {
    text-decoration-color: var(--banner-text);
  }
  .arrow {
    color: var(--banner-accent);
  }
  .email-row {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .email-text {
    font-size: 1.25rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .copy {
    min-width: 5.75rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    font-size: 0.75rem;
    color: var(--banner-text);
    background: transparent;
    border: 1px solid var(--banner-accent);
    cursor: pointer;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .copy:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--banner-text);
  }
  .done {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .done svg {
    color: var(--banner-accent);
  }
  [hidden] {
    display: none !important;
  }
  .linkedin,
  .copy {
    transition: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .linkedin {
      transition: text-decoration-color 0.2s ease;
    }
    .copy {
      transition:
        background-color 0.2s ease,
        border-color 0.2s ease;
    }
  }

  @media (max-width: 51.25rem) {
    .contact {
      padding-top: 3.5rem;
      padding-bottom: 4.5rem;
    }
    .section-title {
      font-size: 1.875rem;
    }
    .actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  import { assemble, copyText } from '../scripts/email';

  // Assemble the address from its parts and show the Copy button only once that has worked.
  // Without JavaScript the address stays in its scraper-resistant "[at]" form.
  const row = document.querySelector<HTMLElement>('[data-email]');
  const address = row ? assemble(row) : null;
  const text = row?.querySelector<HTMLElement>('[data-email-text]');
  const button = row?.querySelector<HTMLButtonElement>('[data-copy]');
  const ready = row?.querySelector<HTMLElement>('[data-copy-ready]');
  const done = row?.querySelector<HTMLElement>('[data-copy-done]');
  const status = row?.querySelector<HTMLElement>('[data-copy-status]');

  if (address && text && button) {
    text.textContent = address;
    button.hidden = false;
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      if (!(await copyText(address))) {
        // Fallback: select the address so it can be copied by hand.
        const range = document.createRange();
        range.selectNodeContents(text);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        if (status) status.textContent = 'Copying failed. The address is selected; copy it with your keyboard.';
        return;
      }
      if (ready) ready.hidden = true;
      if (done) done.hidden = false;
      if (status) status.textContent = 'Email address copied';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (ready) ready.hidden = false;
        if (done) done.hidden = true;
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>
