---
import Base from '../layouts/Base.astro';
import { notFound, hero } from '../data/site';
---

<Base title="Page not found · Fouad Farah" path="/404" noindex footerRule>
  <section class="nf" aria-labelledby="nf-title">
    <div class="dot-field" aria-hidden="true"></div>
    <div class="wrap grid content">
      <p class="rail section-number nf-code" aria-hidden="true">404</p>
      <div class="main">
        <p class="section-number phone-code" aria-hidden="true">404</p>
        <h1 id="nf-title" class="nf-title">{notFound.title}</h1>
        <p class="nf-body">{notFound.body}</p>
        <p class="nf-links">
          <a href="/">{notFound.home}</a>
          <a href={hero.cv.href}>{hero.cv.label} <span aria-hidden="true">↓</span></a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 7rem;
  }
  .content {
    position: relative;
  }
  .nf-code {
    margin: 0;
    padding-top: 0.75rem;
  }
  .phone-code {
    display: none;
    margin: 0 0 0.75rem;
  }
  .nf-title {
    margin: 0;
    font-size: clamp(2.25rem, 4.4vw, 3.5rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .nf-body {
    margin: 1.5rem 0 0;
    max-width: 31.79em; /* 52ch in Schibsted Grotesk 400 */
    font-size: 1.1875rem;
    line-height: 1.6;
  }
  .nf-links {
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }
  .nf-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-weight: 500;
    color: var(--accent);
    text-underline-offset: 5px;
  }
  .nf-links a:hover {
    text-decoration-thickness: 2px;
  }
  @media (max-width: 51.25rem) {
    .nf {
      padding-top: 3rem;
      padding-bottom: 4rem;
    }
    .phone-code {
      display: block;
    }
    .nf-title {
      font-size: 2rem;
    }
    .nf-body {
      font-size: 1.0625rem;
    }
  }
</style>
